# Settings for the live model providers. Nothing here is needed for the offline quickstart
# (recorded extraction, validation, reasoning, queries, ask and the explorer app).
#
# Only `docker compose` reads a .env file (copy this file to .env and fill in what you use).
# The command line does not: export the variables in your shell instead.

# Default provider for `steel-ontology extract` and `ask` when --provider is not given:
# anthropic | openai | gemini | local | recorded
STEEL_ONTOLOGY_PROVIDER=

# Anthropic (extra: anthropic). The SDK reads this key.
ANTHROPIC_API_KEY=
# STEEL_ONTOLOGY_ANTHROPIC_MODEL=claude-opus-5-5
# 1 lets the API re-run a declined request on its fallback model (off by default; the model
# that actually answered is then reported). Same as --refusal-fallback.
# STEEL_ONTOLOGY_ANTHROPIC_FALLBACKS=1

# OpenAI (extra: openai).
OPENAI_API_KEY=
# STEEL_ONTOLOGY_OPENAI_MODEL=

# Gemini (extra: gemini).
GEMINI_API_KEY=
# STEEL_ONTOLOGY_GEMINI_MODEL=

# A local OpenAI-compatible server (llama.cpp, Ollama, vLLM). No extra needed.
# STEEL_ONTOLOGY_LOCAL_URL=http://localhost:8080/v1
# STEEL_ONTOLOGY_LOCAL_MODEL=
# STEEL_ONTOLOGY_LOCAL_API_KEY=

# Java for the HermiT reasoner (extra: hermit), when java is not on the PATH.
# STEEL_ONTOLOGY_JAVA=/path/to/bin/java
