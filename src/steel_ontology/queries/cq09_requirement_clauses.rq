# id: CQ09
# title: Requirement clauses on one topic
# question: Which requirement clauses cover a topic (welding by default)?
# param: topic = WeldingReq

PREFIX steel: <https://jaymirzaei.github.io/steel-drawing-ontology/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?clause ?number ?text ?value WHERE {
    ?clause a steel:RequirementClause ;
            steel:requirementTopic ?topic .
    OPTIONAL { ?clause steel:clauseNumber ?number }
    OPTIONAL { ?clause steel:clauseText ?text }
    OPTIONAL { ?clause steel:clauseValue ?value }
}
ORDER BY ?clause
