# id: CQ16
# title: Values that hold for tender only
# question: Which schedule rows or cells are marked as tender-only values, to be replaced later?

PREFIX steel: <https://jaymirzaei.github.io/steel-drawing-ontology/core#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item WHERE {
    ?item steel:isTenderOnly true .
}
ORDER BY ?item
