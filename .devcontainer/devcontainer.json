{
  "name": "steel-drawing-ontology",
  "image": "mcr.microsoft.com/devcontainers/python:3.3.4-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1.8.3": {
      "version": "21"
    }
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pipx install uv==0.12.13 && uv sync --frozen --extra app --extra hermit",
  "postAttachCommand": {
    "app": "uv run streamlit run app/explorer.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false --browser.gatherUsageStats=false"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit explorer",
      "onAutoForward": "openBrowser"
    }
  }
}
