ex:clause-1 a steel:RequirementClause ;
    steel:citesStandard ex:standard-CSA-G40-21 ;
    steel:clauseNumber "1" ;
    steel:clauseText "W SHAPES AND HSS: CSA G40.21 GRADE 350W." ;
    steel:clauseValue "350W" ;
    steel:evidencedBy ex:ev-clause-1 ;
    steel:requirementTopic steel:MaterialReq .

ex:clause-2 a steel:RequirementClause ;
    steel:citesStandard ex:standard-ASTM-F3125 ;
    steel:clauseNumber "2" ;
    steel:clauseText "BOLTS: ASTM F3125 GRADE A325, 20 mm DIAMETER, SNUG TIGHT UNLESS NOTED." ;
    steel:clauseValue "20 mm A325" ;
    steel:evidencedBy ex:ev-clause-2 ;
    steel:requirementTopic steel:BoltingReq .

ex:clause-3 a steel:RequirementClause ;
    steel:citesStandard ex:standard-CSA-W59 ;
    steel:clauseNumber "3" ;
    steel:clauseText "WELDING TO CSA W59. MINIMUM FILLET WELD 6 mm." ;
    steel:clauseValue "6 mm" ;
    steel:evidencedBy ex:ev-clause-3 ;
    steel:requirementTopic steel:WeldingReq .

ex:clause-4 a steel:RequirementClause ;
    steel:clauseNumber "4" ;
    steel:clauseText "DO NOT FIELD CUT OR BURN HOLES IN BASE PLATES." ;
    steel:evidencedBy ex:ev-clause-4 ;
    steel:isProhibition true ;
    steel:requirementTopic steel:ErectionReq .

ex:clause-5 a steel:RequirementClause ;
    steel:clauseNumber "5" ;
    steel:clauseText "UNLESS NOTED OTHERWISE, DESIGN BRACE CONNECTIONS FOR 50% OF THE TENSILE YIELD RESISTANCE OF THE BRACE." ;
    steel:clauseValue "50%" ;
    steel:evidencedBy ex:ev-clause-5 ;
    steel:isDefaultRuleClause true ;
    steel:requirementTopic steel:ConnectionDesignReq .

ex:clause-6 a steel:RequirementClause ;
    steel:clauseNumber "6" ;
    steel:clauseText "CONNECTIONS NOT DETAILED ON THESE DRAWINGS ARE TO BE DESIGNED BY THE FABRICATOR'S CONNECTION ENGINEER. SUBMIT SEALED CALCULATIONS." ;
    steel:clauseValue "sealed calculations" ;
    steel:evidencedBy ex:ev-clause-6 ;
    steel:requirementTopic steel:SubmittalReq .

ex:clause-7 a steel:RequirementClause ;
    steel:clauseNumber "7" ;
    steel:clauseText "ANCHOR RODS AND GROUT ARE SUPPLIED AND INSTALLED BY OTHERS." ;
    steel:clauseValue "by others" ;
    steel:evidencedBy ex:ev-clause-7 ;
    steel:requirementTopic steel:ScopeExclusionReq .

ex:clause-8 a steel:RequirementClause ;
    steel:clauseNumber "8" ;
    steel:clauseText "GRATING IS SUPPLIED BY THE GRATING SUPPLIER AND INSTALLED BY THE STEEL ERECTOR." ;
    steel:clauseValue "supply by supplier" ;
    steel:evidencedBy ex:ev-clause-8 ;
    steel:requirementTopic steel:GratingReq .

ex:clause-9 a steel:RequirementClause ;
    steel:clauseNumber "9" ;
    steel:clauseText "GIVE 48 HOURS NOTICE BEFORE EACH FIELD REVIEW." ;
    steel:clauseValue "48 hours" ;
    steel:evidencedBy ex:ev-clause-9 ;
    steel:noticeHours 48 ;
    steel:requirementTopic steel:InspectionReq .

ex:connection-SC1 a steel:ShearConnection ;
