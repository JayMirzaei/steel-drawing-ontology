@prefix ex: <https://example.org/kestrel-platform/> .
@prefix steel: <https://jaymirzaei.github.io/steel-drawing-ontology/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:connection-brace a steel:BraceConnection ;
    steel:connects ex:brace-VB1,
        ex:column-C1 ;
    steel:evidencedBy ex:ev-connection-brace ;
    steel:isDesignOpen true ;
    steel:requiresSealedDesign true ;
    steel:responsibility steel:ByConnectionEngineer .

ex:drawing-set a steel:DrawingSet ;
    steel:authorRole steel:EngineerOfRecordRole ;
    steel:hasSheet ex:sheet-S-001,
        ex:sheet-S-101,
        ex:sheet-S-201,
        ex:sheet-S-301 ;
    steel:inDomain steel:PlatformStairDomain ;
    steel:projectNumber "EX-0417" ;
    steel:revisionCodeScheme "letters before the construction issue, then numbers" ;
    steel:unitSystem steel:Metric .

ex:grating a steel:Grating ;
    steel:evidencedBy ex:ev-grating ;
    steel:inZone ex:zone-platform ;
    steel:responsibility steel:BySupplier ;
    steel:workKind steel:InstallOnly .

ex:anchor-rods a steel:Fastener ;
    steel:evidencedBy ex:ev-anchor-rods ;
    steel:responsibility steel:ByOthers .

ex:annotation-query-note a steel:Annotation ;
    steel:annotates ex:beam-B3 ;
    steel:annotationOrigin steel:ThirdPartyOrigin ;
    steel:annotationText "CONFIRM B3 SIZE?" ;
    steel:evidencedBy ex:ev-annotation-query-note ;
    steel:markupKind steel:QueryNote .

ex:annotation-received-stamp a steel:Annotation ;
    steel:annotationOrigin steel:ThirdPartyOrigin ;
    steel:annotationText "RECEIVED" ;
    steel:evidencedBy ex:ev-annotation-received-stamp ;
    steel:markupKind steel:ReceivedStamp ;
    steel:stampDate "2030-03-20" .

ex:annotation-revision-cloud a steel:Annotation ;
