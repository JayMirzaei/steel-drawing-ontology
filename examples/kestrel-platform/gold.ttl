    steel:annotationOrigin steel:ThirdPartyOrigin ;
    steel:evidencedBy ex:ev-annotation-takeoff-highlight ;
    steel:markupKind steel:TakeoffHighlight ;
    steel:markupMeaningText "orange highlight = taken off" .

ex:area-load-DeadLoad a steel:AreaLoad ;
